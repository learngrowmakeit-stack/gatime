# Copy to .env.local for local development, or add these in Vercel.
# Both values are public frontend configuration, NOT a service-role secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret for /api/translate. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=
# Optional override; default follows Google's documented Flash alias.
GEMINI_MODEL=gemini-flash-latest
