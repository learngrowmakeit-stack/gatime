{
  "functions": {
    "api/translate.js": {
      "maxDuration": 60
    },
    "api/delete-account.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/downloads/gatime-test.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"gatime-test.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
